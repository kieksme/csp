{
  "display_information": {
    "name": "Support",
    "description": "Portal-Chats im Support-Channel begleiten und als Mensch übernehmen",
    "background_color": "#20273b"
  },
  "features": {
    "bot_user": { "display_name": "Support", "always_online": false }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://REPLACE_WITH_API_HOST/api/slack/events",
      "bot_events": ["message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://REPLACE_WITH_API_HOST/api/slack/actions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
