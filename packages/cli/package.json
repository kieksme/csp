{
  "name": "@kieksme/csp-cli",
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "template",
    "runtime"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node ../../scripts/sync-template.mjs && tsup src/index.ts --format esm --dts --clean --external @kieksme/csp-sdk --external react --external react-dom --external @kieksme/csp-core/* --external vite --external @vitejs/plugin-react --external esbuild --external dotenv --external zod"
  },
  "dependencies": {
    "@kieksme/csp-sdk": "workspace:^",
    "semver": "^7.7.3",
    "yaml": "^2.8.1",
    "@kieksme/csp-core": "workspace:^",
    "vite": "^7.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "dotenv": "^17.2.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "csp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieksme/customer-service-portal.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kieksme/customer-service-portal/issues"
  }
}
