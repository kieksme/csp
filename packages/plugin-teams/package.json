{
  "name": "@kieksme/csp-plugin-teams",
  "version": "0.13.2",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "teams-app"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup src/browser.tsx src/server.ts --format esm --dts --clean --external @kieksme/csp-sdk --external react --external react-dom"
  },
  "dependencies": {
    "@kieksme/csp-sdk": "workspace:^",
    "zod": "^3.25.76",
    "@microsoft/teams.apps": "^2.0.0",
    "@microsoft/teams.api": "^2.0.0",
    "@kieksme/csp-core": "workspace:^"
  },
  "engines": {
    "node": ">=22.12"
  },
  "cspPlugin": {
    "id": "teams",
    "sdkVersion": "^0.13.2",
    "browser": "./browser",
    "server": "./server",
    "requires": [
      "chat"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieksme/customer-service-portal.git",
    "directory": "packages/plugin-teams"
  },
  "bugs": {
    "url": "https://github.com/kieksme/customer-service-portal/issues"
  }
}
