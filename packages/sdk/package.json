    "build": "tsup src/index.ts src/browser.tsx --format esm --dts --clean --external react --external fastify"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "semver": "^7.7.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "fastify": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieksme/customer-service-portal.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/kieksme/customer-service-portal/issues"
  }
