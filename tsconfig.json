{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "noEmit": true,
    "paths": {
      "@kieksme/csp-sdk": ["./packages/sdk/src/index.ts"],
      "@kieksme/csp-core/*": ["./packages/core/src/*"],
      "@kieksme/csp-plugin-contact/*": ["./packages/plugin-contact/src/*"],
      "@kieksme/csp-plugin-signl4/*": ["./packages/plugin-signl4/src/*"],
      "@kieksme/csp-plugin-kuma/*": ["./packages/plugin-kuma/src/*"],
      "@kieksme/csp-plugin-content/*": ["./packages/plugin-content/src/*"],
      "@kieksme/csp-plugin-chat/*": ["./packages/plugin-chat/src/*"],
      "@kieksme/csp-sdk/browser": ["./packages/sdk/src/browser.tsx"]
    }
  },
  "include": ["packages", "apps", "templates", "tests", "scripts", "*.ts"],
  "exclude": [
    "packages/cli/template",
    "**/dist",
    "**/dist-api",
    "**/node_modules"
  ]
}
