# Nur API-Runtime. Für das nach setup:teams erzeugte portal.support.json.
# Bestehende Provider-Konfiguration zusätzlich übernehmen.
CSP_CONFIG_PATH=portal.support.json
CSP_TEAMS_ENABLED=true
CSP_TEAMS_DEMO=false
CSP_CHAT_RETENTION_DAYS=30
CSP_CHAT_DATABASE_URL=postgresql://REPLACE_WITH_SECRET_REFERENCE
CSP_ENTRA_TENANT_ID=REPLACE_WITH_TENANT_GUID
CSP_ENTRA_API_AUDIENCE=REPLACE_WITH_API_APP_GUID
CSP_ENTRA_API_SCOPE=Chat.Access
CSP_ENTRA_PORTAL_CLIENT_ID=REPLACE_WITH_SPA_APP_GUID
CSP_TEAMS_APP_ID=REPLACE_WITH_BOT_APP_GUID
CSP_TEAMS_APP_SECRET=REPLACE_WITH_SECRET_REFERENCE
CSP_TEAMS_TEAM_ID=REPLACE_WITH_TEAM_ID
CSP_TEAMS_CHANNEL_ID=REPLACE_WITH_PORTAL_SUPPORT_CHANNEL_ID
CSP_TEAMS_SUPPORT_GROUP_ID=REPLACE_WITH_ENTRA_SUPPORT_GROUP_GUID
CSP_TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams/

# group (default): arbitrary Entra group; team: the team Microsoft 365 group, RSC only
CSP_TEAMS_SUPPORT_AUTH=group
