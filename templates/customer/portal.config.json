{
  "schemaVersion": 1,
  "id": "customer",
  "branding": {
    "name": "Service Desk",
    "tagline": "Wir sind für Sie da.",
    "description": "Ihr direkter Kontakt zum Operations-Team."
  },
  "theme": {
    "mode": "system",
    "tokens": {
      "accent": "#176b58",
      "hero": "#102e29",
      "fontFamily": "Manrope, sans-serif",
      "fontMono": "\"IBM Plex Mono\", monospace",
      "fontSize": "16px",
      "radius": "4px",
      "spacing": "4px",
      "contentWidth": "1144px",
      "heroWidth": "1264px"
    },
    "darkTokens": {
      "paper": "#111d19",
      "card": "#192923",
      "ink": "#e4ebe3",
      "muted": "#a8b9ae",
      "line": "#33483b",
      "soft": "#24372b"
    }
  },
  "contact": {
    "phone": "+49 000 000000",
    "label": "Operations-Hotline"
  },
  "public": {
    "apiUrl": "http://localhost:3001",
    "basePath": "/",
    "demo": false
  },
  "contentFile": "content.json",
  "plugins": [
    "@kieksme/csp-plugin-contact",
    "@kieksme/csp-plugin-content",
    "@kieksme/csp-plugin-chat"
  ]
}
