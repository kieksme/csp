# Branding, contents and plugin selection: portal.config.json
# Optional public overrides: CSP_NAME, CSP_API_URL, CSP_BASE_PATH, CSP_DOMAIN, CSP_CONTACT_PHONE
# Runtime values and provider secrets (never committed):
CSP_ALLOWED_ORIGINS=http://localhost:5173
CSP_PORT=3001
CSP_DEMO=false
# Optional: CSP_DOMAIN, CSP_LOGO_URL, CSP_ICON_PATH, CSP_AVATARS_PATH
# WebMCP tools for browser agents are on by default; CSP_WEBMCP=false opts out.
# CSP_WEBMCP=true
# SIGNL4 plugin (install separately in the customer template)
# CSP_SIGNL4_API_KEY=
# CSP_SIGNL4_TEAM_ID=
# CSP_SIGNL4_TIMEZONE=Europe/Berlin
# Uptime Kuma plugin (install separately in the customer template)
# CSP_KUMA_URL=https://status.example.invalid
# CSP_KUMA_SLUG=customer
# Chat: openai | azure | ollama; model is required for real providers.
# CSP_CHAT_DEMO=false enables a real chat provider alongside CSP_DEMO=true.
CSP_CHAT_PROVIDER=ollama
CSP_CHAT_MODEL=llama3.2
CSP_CHAT_OLLAMA_URL=http://localhost:11434
# CSP_CHAT_OPENAI_API_KEY=
# CSP_CHAT_AZURE_API_KEY=
# CSP_CHAT_AZURE_ENDPOINT=https://resource.openai.azure.com
CSP_CHAT_RATE_LIMIT=10
CSP_CHAT_CONCURRENCY=2
CSP_CHAT_MAX_TOKENS=1024

# CSP_CHAT_TIMEOUT_MS=60000
