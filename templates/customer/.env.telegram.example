# API runtime only. Never commit real tokens or expose them in frontend builds.
CSP_CONFIG_PATH=portal.telegram.json
CSP_DEMO=false
CSP_TELEGRAM_ENABLED=true
CSP_TELEGRAM_DEMO=false
CSP_TELEGRAM_AUTH=anonymous
CSP_TELEGRAM_BOT_TOKEN=
CSP_TELEGRAM_WEBHOOK_SECRET=
CSP_TELEGRAM_CHAT_ID=
CSP_TELEGRAM_SUPPORT_USER_IDS=
CSP_CHAT_DATABASE_URL=
CSP_CHAT_SESSION_SECRET=
CSP_CHAT_RETENTION_DAYS=30
# Set only behind a trusted proxy with no public direct API port.
CSP_TRUST_PROXY=true
# For authenticated portals use CSP_TELEGRAM_AUTH=entra and configure:
# CSP_ENTRA_TENANT_ID=
# CSP_ENTRA_API_AUDIENCE=
# CSP_ENTRA_PORTAL_CLIENT_ID=
# CSP_ENTRA_API_SCOPE=Chat.Access
