{
  "name": "customer-service-portal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter csp-demo build && pnpm --filter csp-northstar build && pnpm --filter csp-customer-template build",
    "dev": "pnpm --filter csp-demo dev",
    "dev:api": "pnpm --filter csp-demo dev:api",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:packages": "tsx scripts/package-smoke.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm -r --filter \"./packages/**\" build && changeset publish",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.9",
    "sharp": "^0.34.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
