{
  "name": "csp-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch --env-file=.env.development server.ts",
    "build": "vite build && tsup server.ts --format esm --platform node --out-dir dist-api --external sharp",
    "start:api": "node dist-api/server.js",
    "dev:support": "CSP_DEMO=true CSP_TEAMS_DEMO=true vite --host 127.0.0.1",
    "dev:api:support": "CSP_DEMO=true CSP_TEAMS_DEMO=true tsx --env-file=.env.development server.ts",
    "build:support": "CSP_DEMO=true CSP_TEAMS_DEMO=true CSP_API_URL=http://127.0.0.1:3017 vite build --outDir dist-support"
  },
  "dependencies": {
    "@kieksme/csp-core": "workspace:^",
    "@kieksme/csp-plugin-contact": "workspace:^",
    "@kieksme/csp-plugin-signl4": "workspace:^",
    "@kieksme/csp-plugin-kuma": "workspace:^",
    "@kieksme/csp-plugin-content": "workspace:^",
    "@kieksme/csp-plugin-chat": "workspace:^",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "dotenv": "^17.2.3",
    "@kieksme/csp-sdk": "workspace:^",
    "@kieksme/csp-plugin-teams": "workspace:^"
  },
  "devDependencies": {
    "vite": "^7.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "tsup": "^8.5.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.8.1",
  "version": "0.8.0"
}
